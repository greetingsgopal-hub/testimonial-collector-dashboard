rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOwnerUnchanged() {
      return request.resource.data.ownerId == resource.data.ownerId;
    }

    // 1. Workspaces
    // Only the workspace owner can read, update, or delete their workspace
    // Prevents tenant ownership re-assignment on update
    match /workspaces/{workspaceId} {
      allow read: if isOwner(resource.data.ownerId);
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(resource.data.ownerId) && isOwnerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }

    // 2. Projects
    // Public GET allowed for branding display on customer-facing collection forms
    // All modifications require authenticated ownership; ownerId cannot be mutated
    match /projects/{projectId} {
      allow get: if isOwner(resource.data.ownerId);
      allow list: if isOwner(resource.data.ownerId);
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(resource.data.ownerId) && isOwnerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }

    // 3. Collection Forms
    // Owner manages collection; anonymous visitors can read active collection forms
    // ownerId cannot be mutated on update
    match /collection_forms/{formId} {
      allow read: if (isAuthenticated() && resource.data.ownerId == request.auth.uid) || resource.data.isActive == true;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(resource.data.ownerId) && isOwnerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }

    // 4. Private Reviews (Operational Store)
    // Full records including customer email.
    // Anonymous users CANNOT read arbitrary reviews or emails.
    match /reviews/{reviewId} {
      // Private operational records are tenant-isolated.
      allow read: if isOwner(resource.data.ownerId);
      allow update: if isOwner(resource.data.ownerId) && isOwnerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);

      // Anonymous public submission. App Check should be enforced in Firebase
      // for production abuse protection; these rules provide the data-integrity boundary.
      allow create: if
        request.resource.data.keys().hasOnly([
          'projectId', 'collectionFormId', 'ownerId', 'name', 'email', 'role', 'company',
          'avatarUrl', 'rating', 'title', 'content', 'type', 'videoUrl', 'tags', 'source',
          'status', 'isFeatured', 'consent', 'helpfulCount', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.source == 'form' &&
        request.resource.data.isFeatured == false &&
        request.resource.data.consent == true &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 1 &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 150 &&
        request.resource.data.role is string &&
        request.resource.data.role.size() <= 120 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() >= 10 &&
        request.resource.data.content.size() <= 2500 &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.type in ['text', 'video'] &&
        request.resource.data.tags is list &&
        request.resource.data.tags.size() <= 10 &&
        request.resource.data.collectionFormId is string &&
        exists(/databases/$(database)/documents/collection_forms/$(request.resource.data.collectionFormId)) &&
        get(/databases/$(database)/documents/collection_forms/$(request.resource.data.collectionFormId)).data.isActive == true &&
        request.resource.data.ownerId == get(/databases/$(database)/documents/collection_forms/$(request.resource.data.collectionFormId)).data.ownerId &&
        request.resource.data.projectId == get(/databases/$(database)/documents/collection_forms/$(request.resource.data.collectionFormId)).data.projectId;
    }

    // 5. Public Approved Reviews (Zero-Trust Display Store)
    // Stripped of customer email and private metadata.
    // Public visitors can read approved reviews safely.
    // Writes are only allowed to the authenticated owner of the PRIVATE review with the same ID.
    // Prevents injecting fake public reviews or mutating ownerId.
    match /public_reviews/{reviewId} {
      // Only approved, email-free testimonial records are publicly readable.
      // Public queries must include status == 'approved'.
      allow read: if resource.data.status == 'approved';

      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly([
          'projectId', 'collectionFormId', 'ownerId', 'name', 'role', 'company', 'avatarUrl',
          'rating', 'title', 'content', 'type', 'videoUrl', 'tags', 'isFeatured', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.status == 'approved' &&
        exists(/databases/$(database)/documents/reviews/$(reviewId)) &&
        get(/databases/$(database)/documents/reviews/$(reviewId)).data.ownerId == request.auth.uid &&
        get(/databases/$(database)/documents/reviews/$(reviewId)).data.projectId == request.resource.data.projectId &&
        get(/databases/$(database)/documents/reviews/$(reviewId)).data.collectionFormId == request.resource.data.collectionFormId;

      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'projectId', 'collectionFormId', 'ownerId', 'name', 'role', 'company', 'avatarUrl',
          'rating', 'title', 'content', 'type', 'videoUrl', 'tags', 'isFeatured', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.ownerId == request.auth.uid &&
        isOwnerUnchanged() &&
        request.resource.data.status == 'approved' &&
        exists(/databases/$(database)/documents/reviews/$(reviewId)) &&
        get(/databases/$(database)/documents/reviews/$(reviewId)).data.ownerId == request.auth.uid &&
        get(/databases/$(database)/documents/reviews/$(reviewId)).data.projectId == request.resource.data.projectId &&
        get(/databases/$(database)/documents/reviews/$(reviewId)).data.collectionFormId == request.resource.data.collectionFormId;

      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // 6. Social Connections (Tenant-isolated credentials & account links)
    // Only the owner can read, update, or delete their social account connection
    match /social_connections/{connectionId} {
      allow read: if isOwner(resource.data.ownerId);
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(resource.data.ownerId) && isOwnerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }

    // 7. Social Publications (Audit log and published post records)
    // Only the owner can view and manage their publication records
    match /social_publications/{publicationId} {
      allow read: if isOwner(resource.data.ownerId);
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(resource.data.ownerId) && isOwnerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }
  }
}
