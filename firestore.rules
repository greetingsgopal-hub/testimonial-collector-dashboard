rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Workspaces
    // Only the workspace owner can read, update, or delete their workspace
    match /workspaces/{workspaceId} {
      allow read: if isOwner(resource.data.ownerId);
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.ownerId);
    }

    // 2. Projects
    // Only the owner can access private project configuration.
    // Public collector needs to read project name/slug to display branding — allowed for GET only
    // (project docs contain no sensitive PII; name, slug, websiteUrl are non-secret branding data)
    match /projects/{projectId} {
      allow get: if isOwner(resource.data.ownerId) || true; // Public GET allowed for branding display
      allow list: if isOwner(resource.data.ownerId);
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.ownerId);
    }

    // 3. Collection Forms
    // Owner manages collection; anonymous visitors can read active collection forms
    match /collection_forms/{formId} {
      allow read: if (isAuthenticated() && resource.data.ownerId == request.auth.uid) || resource.data.isActive == true;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.ownerId);
    }

    // 4. Private Reviews (Operational Store)
    // Full records including customer email.
    // Anonymous users CANNOT read arbitrary reviews or email.
    match /reviews/{reviewId} {
      // Owner has full access to reviews belonging to their tenant
      allow read, update, delete: if isOwner(resource.data.ownerId);

      // Anonymous public submission (Strictly Validated):
      // Must submit as 'pending', cannot feature itself, must include consent,
      // and must target a genuinely active collectionForm with verified ownerId and projectId.
      allow create: if 
        request.resource.data.status == 'pending' &&
        request.resource.data.isFeatured == false &&
        request.resource.data.consent == true &&
        request.resource.data.collectionFormId != null &&
        exists(/databases/$(database)/documents/collection_forms/$(request.resource.data.collectionFormId)) &&
        get(/databases/$(database)/documents/collection_forms/$(request.resource.data.collectionFormId)).data.isActive == true &&
        request.resource.data.ownerId == get(/databases/$(database)/documents/collection_forms/$(request.resource.data.collectionFormId)).data.ownerId &&
        request.resource.data.projectId == get(/databases/$(database)/documents/collection_forms/$(request.resource.data.collectionFormId)).data.projectId;
    }

    // 5. Public Approved Reviews (Zero-Trust Display Store)
    // Stripped of customer email and private metadata.
    // Public visitors can read approved reviews safely.
    // Writes are only allowed to the authenticated owner of the PRIVATE review with the same ID.
    // This prevents any user from injecting fake public reviews under a foreign project.
    match /public_reviews/{reviewId} {
      allow read: if true;
      // Owner can create/update a public_review only if the corresponding private review exists and belongs to them
      allow create, update: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        exists(/databases/$(database)/documents/reviews/$(reviewId)) &&
        get(/databases/$(database)/documents/reviews/$(reviewId)).data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid;
    }
  }
}
