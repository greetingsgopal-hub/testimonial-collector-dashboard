{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "testimonial-collector-dashboard2",
  "account_id": "04b586d238bb60304c8fc2501beaecf3",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "testimonialcollectordashboard",
    "META_APP_ID": "1093657506579806"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "ed7ef4cc06c940c882448d3fcba25398"
    }
  ],
  "routes": [
    {
      "pattern": "pandapraise.com/*",
      "zone_name": "pandapraise.com"
    }
  ]
}
