# =========================================================================
# Environment Variables Configuration
# =========================================================================
# By default, Panda Praise uses the built-in LocalStorage adapter with rich
# sample data. It works immediately out-of-the-box with zero configuration!
#
# To connect your cloud database or backend, configure Firebase below:

# -------------------------------------------------------------------------
# Firebase (Authentication, Cloud Firestore, Firebase Storage)
# -------------------------------------------------------------------------
# 1. Create a project in the Firebase Console: https://console.firebase.google.com/
# 2. Enable Authentication (Email/Password)
# 3. Enable Cloud Firestore Database (deploy firestore.rules)
# 4. Enable Firebase Storage (deploy storage.rules)
# 5. Add your Firebase Web App configuration credentials:

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
# Optional production abuse protection: Firebase App Check reCAPTCHA Enterprise site key.
# Configure the same site key in Firebase Console > App Check, then enable enforcement.
VITE_FIREBASE_APPCHECK_SITE_KEY=your-recaptcha-enterprise-site-key
# Keep App Check disabled until the production reCAPTCHA key is verified for every deployed domain.
VITE_FIREBASE_APPCHECK_ENABLED=false
# Local development only: set to true to make the App Check SDK print a debug token
# to the browser console. Register that token in Firebase Console > App Check >
# Apps > Manage debug tokens so localhost works while enforcement is on.
# Must be false (or absent) in production builds.
VITE_FIREBASE_APPCHECK_DEBUG=false
# Backend API URL. Leave unset in production — the app calls the same-origin
# Cloudflare Worker at /api/*. Only set this if the backend runs on a different
# origin (legacy/testing).
# VITE_FUNCTIONS_API_URL=

# -------------------------------------------------------------------------
# Social Integrations & Reviews Sync (Cloudflare Worker Environment Secrets):
# -------------------------------------------------------------------------
# LinkedIn OAuth:
# LINKEDIN_CLIENT_ID=your_linkedin_client_id
# LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
# LINKEDIN_REDIRECT_URI=https://your-domain.com/api/auth/linkedin/callback
#
# Google Business Profile & Google Places Reviews:
# GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_REDIRECT_URI=https://your-domain.com/api/auth/google/callback
# GOOGLE_PLACES_API_KEY=your_google_places_api_key
#
# Meta / Instagram & Facebook Page Reviews, Comments & Webhooks:
# META_APP_ID=your_meta_app_id
# META_APP_SECRET=your_meta_app_secret
# INSTAGRAM_REDIRECT_URI=https://your-domain.com/api/auth/instagram/callback
# FACEBOOK_REDIRECT_URI=https://your-domain.com/api/auth/facebook/callback
# META_WEBHOOK_VERIFY_TOKEN=your_secure_random_webhook_verify_token
#
# Token Encryption:
# APP_ENCRYPTION_KEY=32_character_random_encryption_secret_key_here
#
# Firebase service account (Worker secret, required for Firestore admin ops):
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}
# (or set FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY separately)
#
# -------------------------------------------------------------------------
# Razorpay Billing (Primary Processor for India & Global):
# -------------------------------------------------------------------------
# Set via: npx wrangler secret put RAZORPAY_KEY_ID
#          npx wrangler secret put RAZORPAY_KEY_SECRET
#          npx wrangler secret put RAZORPAY_WEBHOOK_SECRET
#
# RAZORPAY_KEY_ID=rzp_test_... (or rzp_live_...)
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret (from Dashboard > Settings > Webhooks)
#
# Plan IDs (Created in Razorpay Dashboard > Products > Plans):
# RAZORPAY_PLAN_MONTHLY=plan_...    (e.g., ₹799/month)
# RAZORPAY_PLAN_ANNUAL=plan_...     (e.g., ₹4,788/year)
# RAZORPAY_FOUNDING_AMOUNT=1199900  (Founding Member Lifetime Pro in paise: ₹11,999)
#
# Stripe billing (Legacy fallback):
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_SUBSCRIPTION_MONTHLY=price_...   (Pro Monthly)
# STRIPE_PRICE_SUBSCRIPTION_ANNUAL=price_...    (Pro Annual)
# STRIPE_PRICE_FOUNDING_LIFETIME=price_...      (Founding Member Lifetime Access)

# -------------------------------------------------------------------------
# Cloudflare Worker Bindings & Bot Abuse Prevention:
# -------------------------------------------------------------------------
# Cloudflare Turnstile CAPTCHA (Fail-closed in production):
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAA...          (Frontend client key)
# TURNSTILE_SECRET_KEY=0x4AAAAAA...             (Worker secret key)
#
# Cloudflare KV Storage:
# RATE_LIMIT_KV=<bound via wrangler.jsonc or npx wrangler kv namespace create RATE_LIMIT_KV>
#
# Environment Mode:
# NODE_ENV=production



