rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isTenantOwner(tenantId) {
      return isAuthenticated() && request.auth.uid == tenantId;
    }

    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024 &&
             request.resource.contentType.matches('image/(jpeg|png|webp|gif|svg\\+xml)');
    }

    // Public avatars and testimonial media:
    // Anyone can read public media.
    // Writes and deletes STRICTLY require authenticated tenant ownership to prevent
    // unauthorized overwriting, defacement, or storage quota exhaustion.
    match /public/{tenantId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isTenantOwner(tenantId) && isValidImage();
      allow delete: if isTenantOwner(tenantId);
    }

    // Owner-only private uploads
    match /tenants/{tenantId}/{allPaths=**} {
      allow read: if isTenantOwner(tenantId);
      allow create, update: if isTenantOwner(tenantId) && isValidImage();
      allow delete: if isTenantOwner(tenantId);
    }
  }
}
